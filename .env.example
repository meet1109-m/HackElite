# =========================================================================
# SmartBinX Full-Stack Docker Environment Configuration
# =========================================================================

# Application Environment
ENVIRONMENT=production-container
PROJECT_NAME="SmartBinX Backend"
VERSION="1.0.0"

# Service Ports
FRONTEND_PORT=5173
BACKEND_PORT=8000
REDIS_PORT=6379
POSTGRES_PORT=5432

# Database Selection:
# Option A: PostgreSQL in Docker (Default multi-tier stack)
DATABASE_URL=postgresql://smartbinx_user:smartbinx_pass@db:5432/smartbinx_db

# Option B: Persistent SQLite in Docker
# DATABASE_URL=sqlite:////app/data/smartbinx.db

# PostgreSQL Credentials (Matches Option A above)
POSTGRES_USER=smartbinx_user
POSTGRES_PASSWORD=smartbinx_pass
POSTGRES_DB=smartbinx_db

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=True

# Security Keys
SECRET_KEY=smartbinx-secure-jwt-secret-key-ahmedabad-2026
MUNICIPAL_API_KEY=smartbinx-ahmedabad-municipal-key-2026

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
