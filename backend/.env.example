# ===============================================
# SmartBinX Backend Environment Configuration
# ===============================================

# App Config
PROJECT_NAME="SmartBinX Backend"
VERSION="1.0.0"
ENVIRONMENT="Demo environment — simulated operational data"

# Database Configuration
# Default: Local SQLite (Works 100% offline, zero setup)
DATABASE_URL="sqlite:///./smartbinx.db"

# Cloud PostgreSQL / Supabase Alternative (Provided by Ronak):
# DATABASE_URL="postgresql://postgres:your-password@db.your-ref.supabase.co:5432/postgres"

# Priority Engine Weights
WEIGHT_CURRENT_FILL=0.35
WEIGHT_OVERFLOW_RISK=0.30
WEIGHT_WASTE_TYPE=0.15
WEIGHT_LOCATION_SENSITIVITY=0.10
WEIGHT_GENERATION_RATE=0.10

# Ahmedabad Reference Coordinates
AHMEDABAD_CENTER_LAT=23.0225
AHMEDABAD_CENTER_LNG=72.5714
